# Copy to .env for local development: cp .env.example .env
# Never commit .env. Production secrets live in the host's secret store.

# --- App mode -------------------------------------------------------------
# "test" or "production". Test mode shows the "Test mode" banner on every page
# and allows the dummy OTP. The app refuses to start in production if the
# dummy OTP is enabled.
APP_MODE=test
# Enables the dummy OTP code 123456 (no SMS sent). Must be false in production.
OTP_DUMMY_ENABLED=true
# Digital Business ID (DBID guideline 2022), shown in the site footer. Test mode shows a
# placeholder when empty; the app refuses to start in production without it.
DBID=

# --- Database (Postgres in docker-compose) -------------------------------
# Each worktree/feature uses its own database name, e.g. ecom_cart.
DATABASE_URL=postgresql://ecom:ecom@localhost:5432/ecom?schema=public

# --- Auth.js ------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
# Base URL of the app (needed by Auth.js outside Vercel)
AUTH_URL=http://localhost:3000
# Public base URL for shared links such as storefronts (/s/<shop slug>). Defaults to AUTH_URL.
# APP_URL=https://example.com
AUTH_TRUST_HOST=true

# --- Meilisearch -------------------------------------------------------
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key-change-me-0123456789

# --- S3-compatible storage (MinIO locally) ------------------------------
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_PUBLIC=ecom-public
S3_BUCKET_PRIVATE=ecom-private

# --- Email (Mailpit locally; UI at http://localhost:8025) ---------------
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="Dokan <no-reply@ecom.test>"

# --- Host ports used by docker-compose.yml (change if busy) -------------
POSTGRES_HOST_PORT=5432
MEILI_HOST_PORT=7700
MINIO_API_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
