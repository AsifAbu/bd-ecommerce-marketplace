// Cash-on-delivery collections and shop payouts (US-082, decision D13). In production the
// courier collects the cash into the platform's merchant account; the platform logs each
// collection here and pays the shop within 10 days, minus commission (Guidelines 2021). In
// testing a collection is recorded when the shop order is marked delivered (or by the admin).
// Both are 6-year business records (src/lib/retention.ts): never deleted; a payout is closed with
// a status (paid or cancelled).

enum PayoutStatus {
  pending // batch created, money not sent yet
  paid // sent to the shop (method + reference recorded)
  cancelled // voided before payment; its collections are free for the next batch
}

// Who keeps the delivery charge collected with the order. Delivery charges are not a profit line
// (plan: "Delivery charges pass through to the courier"). In R1 the shop books and pays its own
// courier (D4, no courier integration), so the charge goes to the shop; with the platform's
// courier merchant account (pre-release checklist) it goes to the courier.
enum DeliveryChargesTo {
  shop
  courier
}

model CodCollection {
  id             String    @id @default(cuid())
  shopOrderId    String    @unique @map("shop_order_id")
  // Copied from the shop order so every shop-side query filters by shop_id (ADR-004).
  shopId         String    @map("shop_id")
  // The shop order total collected in cash (items + delivery charge).
  amount         Decimal   @db.Decimal(12, 2)
  itemsAmount    Decimal   @map("items_amount") @db.Decimal(12, 2)
  deliveryCharge Decimal   @map("delivery_charge") @db.Decimal(12, 2)
  // Platform commission on the items, as fixed when the order was placed (0 under the launch offer).
  commission     Decimal   @db.Decimal(12, 2)
  collectedAt    DateTime  @map("collected_at")
  // auto_on_delivery (shop order marked delivered) or admin_manual
  source         String
  recordedById   String?   @map("recorded_by_id")
  // collectedAt + 10 days (Guidelines 2021: sellers paid within 10 days).
  payoutDueAt    DateTime  @map("payout_due_at")
  payoutId       String?   @map("payout_id")
  // Set when the payout that includes this collection is marked paid.
  paidOutAt      DateTime? @map("paid_out_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  shopOrder ShopOrder @relation(fields: [shopOrderId], references: [id], onDelete: Restrict)
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  payout    Payout?   @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@index([shopId, collectedAt])
  @@index([payoutId])
  @@index([paidOutAt, payoutDueAt])
  @@map("cod_collection")
}

model Payout {
  id                String            @id @default(cuid())
  shopId            String            @map("shop_id")
  // Collection dates covered by the batch.
  periodStart       DateTime          @map("period_start")
  periodEnd         DateTime          @map("period_end")
  collectionCount   Int               @map("collection_count")
  // Cash collected for the included shop orders (items + delivery charges).
  gross             Decimal           @db.Decimal(12, 2)
  commission        Decimal           @db.Decimal(12, 2)
  deliveryCharges   Decimal           @map("delivery_charges") @db.Decimal(12, 2)
  deliveryChargesTo DeliveryChargesTo @map("delivery_charges_to")
  // What the shop receives: gross - commission (- delivery charges when they go to the courier).
  net               Decimal           @db.Decimal(12, 2)
  status            PayoutStatus      @default(pending)
  // Earliest 10-day deadline among the included collections.
  dueAt             DateTime          @map("due_at")
  createdById       String?           @map("created_by_id")
  paidAt            DateTime?         @map("paid_at")
  // bank_transfer, bkash, nagad, rocket, cash, cheque
  method            String?
  reference         String?
  recordedById      String?           @map("recorded_by_id")
  cancelledAt       DateTime?         @map("cancelled_at")
  cancelReason      String?           @map("cancel_reason")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  shop        Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  collections CodCollection[]

  @@index([shopId, createdAt])
  @@index([status, dueAt])
  @@map("payout")
}
