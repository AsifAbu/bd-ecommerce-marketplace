// Cart (US-050, US-056, US-058): one cart across shops, split into one order per shop at
// checkout (A1). A row belongs to a logged-in user (userId) or to a guest device (guestToken:
// the SHA-256 of the random value in the httpOnly `cart_guest` cookie); exactly one is set,
// which the cart service enforces. The guest cart merges into the user's cart at login.
// Access is always scoped by the owner (repo.ts).

model CartItem {
  id            String   @id @default(cuid())
  userId        String?  @map("user_id")
  guestToken    String?  @map("guest_token")
  productId     String   @map("product_id")
  variantId     String   @map("variant_id")
  shopId        String   @map("shop_id") // denormalised: the cart groups by shop
  quantity      Int
  // "Save for later": kept out of the totals and of checkout.
  savedForLater Boolean  @default(false) @map("saved_for_later")
  // The unit price the customer last saw (Tk). A different current price shows a notice and
  // blocks checkout until the customer accepts it (which copies the current price here).
  priceAtAdd    Decimal  @map("price_at_add") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user    User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  shop    Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // One row per variant per owner (Postgres treats NULLs as distinct, so each applies only
  // to rows of that kind of owner).
  @@unique([userId, variantId])
  @@unique([guestToken, variantId])
  @@index([guestToken])
  @@index([variantId])
  @@index([shopId])
  @@index([updatedAt])
  @@map("cart_item")
}
