// Accounts feature: addresses, phone OTP codes and email link tokens.
// An identifier counts as "verified" only through an OTP (phone) or an email link.

// Bangladesh address format. Division, district and upazila names come from
// src/features/accounts/locations.ts.
model Address {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  phone     String // E.164, +8801XXXXXXXXX
  division  String
  district  String
  upazila   String // upazila or thana
  area      String
  line1     String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("address")
}

enum OtpPurpose {
  phone_verify
  password_reset
}

// One row per OTP sent. Only an HMAC of the code is stored. The rows also
// drive the per-number and per-IP send rate limits.
model OtpCode {
  id         String     @id @default(cuid())
  phone      String
  purpose    OtpPurpose
  codeHash   String     @map("code_hash")
  ip         String?
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at")
  consumedAt DateTime?  @map("consumed_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([phone, purpose, createdAt])
  @@index([ip, createdAt])
  @@map("otp_code")
}

enum AccountTokenType {
  password_reset
  email_verify
}

// Single-use email link tokens. Only a SHA-256 hash of the token is stored.
model AccountToken {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      AccountTokenType
  tokenHash String           @unique @map("token_hash")
  email     String // the address the link was sent to
  expiresAt DateTime         @map("expires_at")
  usedAt    DateTime?        @map("used_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account_token")
}
