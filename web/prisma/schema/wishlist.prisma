// Wishlist (US-057): products a logged-in customer saves to buy later, optionally with the
// variant (size, colour...) they chose. Guests are sent to log in first and the item is saved
// after login. Access is always scoped by userId (repo.ts).

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  // Null when saved without choosing a variant; one must be chosen before moving to the cart.
  // If the seller deletes the variant, the item stays, without a variant.
  variantId String?  @map("variant_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Postgres treats NULLs as distinct, so the service also checks for an existing
  // (user, product, no variant) row before inserting.
  @@unique([userId, productId, variantId])
  @@index([userId, createdAt])
  @@index([productId])
  @@index([variantId])
  @@map("wishlist_item")
}
